{
  "expo": {
    "name": "Anusha Porter Driver",
    "slug": "anusha-porter-driver",
    "version": "2.28.28",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "config": {
        "googleMapsApiKey": "AIzaSyBMZfGGMXsIOZYBpCRW7lVpPVhaRQnAnjo"
      }
    },
    "android": {
      "versionCode": 83,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.anushaporter.driver",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBMZfGGMXsIOZYBpCRW7lVpPVhaRQnAnjo"
        }
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-font",
      "expo-av",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload KYC verification documents.",
          "cameraPermission": "The app accesses your camera to let you take profile selfies and capture KYC documents."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Anusha Porter Driver collects location data to enable real-time driver tracking while navigating and delivering orders.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "extra": {
      "eas": {
        "projectId": "63b52fbc-7d86-4230-853f-03dd7ffefca1"
      }
    },
    "owner": "anushabazaar2"
  }
}
